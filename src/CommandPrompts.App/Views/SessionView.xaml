<UserControl
    x:Class="CommandPrompts.App.Views.SessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CommandPrompts.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:SessionViewModel}"
    mc:Ignorable="d">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Session Configuration  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,6"
                Padding="12"
                Background="{StaticResource GroupBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 0  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ForegroundBrush}"
                        Text="Name:" />
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,12,6"
                        Style="{StaticResource RoundedTextBoxBorderStyle}">
                        <TextBox Style="{StaticResource RoundedTextBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ForegroundBrush}"
                        Text="Working Dir:" />
                    <Border
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="0,0,0,6"
                        Style="{StaticResource RoundedTextBoxBorderStyle}">
                        <TextBox Style="{StaticResource RoundedTextBoxStyle}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!--  Row 1  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ForegroundBrush}"
                        Text="Command:" />
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,12,6"
                        Style="{StaticResource RoundedTextBoxBorderStyle}">
                        <TextBox Style="{StaticResource RoundedTextBoxStyle}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,8,6"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ForegroundBrush}"
                        Text="Arguments:" />
                    <Border
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,0,0,6"
                        Style="{StaticResource RoundedTextBoxBorderStyle}">
                        <TextBox Style="{StaticResource RoundedTextBoxStyle}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!--  Row 2: Environment Variables  -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Foreground="{StaticResource ForegroundBrush}"
                        Text="Env Vars:" />
                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource RoundedTextBoxBorderStyle}">
                        <TextBox
                            Height="50"
                            AcceptsReturn="True"
                            Style="{StaticResource RoundedTextBoxStyle}"
                            Text="{Binding EnvironmentVariablesText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="One per line: KEY=VALUE"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>

                </Grid>
            </Border>

            <!--  Action Buttons  -->
            <Border Grid.Row="1" Padding="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="90"
                        Command="{Binding RunCommand}"
                        Content="▶ Run" />
                    <Button
                        Width="100"
                        Background="{StaticResource ErrorBrush}"
                        Command="{Binding TerminateCommand}"
                        Content="■ Terminate" />
                    <Button
                        Width="100"
                        Command="{Binding ClearOutputCommand}"
                        Content="Clear Output"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="100"
                        Command="{Binding OpenSessionFolderCommand}"
                        Content="📂 Locate File"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </Border>

            <!--  Output Console  -->
            <Border
                Grid.Row="2"
                Background="{StaticResource ConsoleBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="6">

                <ListBox
                    x:Name="OutputListBox"
                    ItemsSource="{Binding OutputLines}"
                    Style="{StaticResource ConsoleOutputListBoxStyle}">

                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ConsoleOutputListBoxItemStyle}" TargetType="ListBoxItem" />
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OutputLineViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TimestampTextStyle}" Text="{Binding TimestampFormatted}" />
                                <TextBlock
                                    Foreground="{Binding Foreground}"
                                    Style="{StaticResource KindLabelTextStyle}"
                                    Text="{Binding KindLabel}" />
                                <TextBlock
                                    Foreground="{Binding Foreground}"
                                    Style="{StaticResource ConsoleOutputTextStyle}"
                                    Text="{Binding Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="ApplicationCommands.Copy"
                                Header="Copy"
                                InputGestureText="Ctrl+C" />
                            <MenuItem Command="{Binding CopyAllCommand}" Header="Copy All" />
                            <Separator />
                            <MenuItem Command="{Binding ClearOutputCommand}" Header="Clear Output" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>

            <!--  Footer  -->
            <StackPanel
                Grid.Row="3"
                Margin="3,3,3,0"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource FooterTextStyle}"
                    Text="Session ID: " />
                <TextBox
                    FontSize="10"
                    Foreground="{StaticResource TimestampBrush}"
                    IsReadOnly="True"
                    Style="{StaticResource RoundedTextBoxStyle}"
                    Text="{Binding Id, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource FooterTextStyle}"
                    Text="Lines: " />
                <TextBox
                    FontSize="10"
                    Foreground="{StaticResource TimestampBrush}"
                    IsReadOnly="True"
                    Style="{StaticResource RoundedTextBoxStyle}"
                    Text="{Binding OutputLines.Count, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
