<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CommandPrompts.App.Avalonia.ViewModels"
             x:Class="CommandPrompts.App.Avalonia.Views.SessionView"
             x:DataType="vm:SessionViewModel">

    <!--  Surface panel — WPF SessionView root parity  -->
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8">

            <!--  Session configuration (Group panel)  -->
            <Border Grid.Row="0" Padding="12" CornerRadius="6" Margin="0,0,0,6"
                    Background="{StaticResource GroupBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,6" Classes.rounded="True" Text="{Binding Name}" VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Session ID:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" Classes.rounded="True" Text="{Binding Id}" VerticalContentAlignment="Center" IsReadOnly="True" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Command:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,6" Classes.rounded="True" Text="{Binding Command}" VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{StaticResource ForegroundBrush}" />
                    <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding AvailableProfiles}"
                                SelectedValue="{Binding SelectedProfileName}"
                                SelectedValueBinding="{Binding Name}"
                                DisplayMemberBinding="{Binding Name}"
                                PlaceholderText="Select env profile..." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments:" VerticalAlignment="Top" Margin="0,0,8,6"
                            Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,6" Classes.rounded="True" Height="90" AcceptsReturn="True"
                                Text="{Binding Arguments}"
                                ToolTip.Tip="One per line: arg" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Env Vars:" VerticalAlignment="Top" Margin="0,0,8,6"
                            Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,6" Classes.rounded="True" Height="90" AcceptsReturn="True"
                        Text="{Binding EnvironmentVariablesText}"
                        ToolTip.Tip="One per line: KEY=VALUE" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Working Dir:" VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0" Classes.rounded="True" Text="{Binding WorkingDirectory}" VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <!--  Actions  -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <Button Width="90" Content="▶ Run" Command="{Binding RunCommand}" />
                <Button Width="100" Classes.destructive="True" Content="■ Terminate" Command="{Binding TerminateCommand}" />
                <Button Width="100" Classes.secondary="True" Content="Clear Output" Command="{Binding ClearOutputCommand}" />
                <Button Width="100" Classes.secondary="True" Content="Locate File" Command="{Binding OpenSessionFolderCommand}" />
                <TextBlock Classes.statusText="True" Text="{Binding StatusText}" Margin="16,0,0,0" />
            </StackPanel>

            <!--  Output console (ConsoleBackground #0C0C0C, virtualized via Grid * row)  -->
            <ListBox Grid.Row="2" x:Name="OutputListBox" Classes.consoleOutput="True"
                        ItemsSource="{Binding OutputLines}"
                        SelectionMode="Multiple,Toggle"
                        SelectedItems="{Binding SelectedOutputLines, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.KeyBindings>
                    <!--  Ctrl+Shift+C copies the selected line(s); falls back to all when nothing is selected  -->
                    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopySelectedOrAllCommand}" />
                    <!--  Esc clears the current output selection  -->
                    <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
                </ListBox.KeyBindings>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Selected" Command="{Binding CopySelectedCommand}" />
                        <MenuItem Header="Copy All" Command="{Binding CopyAllCommand}" />
                        <Separator />
                        <MenuItem Header="Clear Output" Command="{Binding ClearOutputCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutputLineViewModel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes.listBoxItemBullet="True" Text="●" Margin="0,0,2,0" />
                            <TextBlock Classes.timestampText="True" Text="{Binding TimestampFormatted}" />
                            <TextBlock Classes.kindLabelText="True" Text="{Binding KindLabel}" Foreground="{Binding Foreground}" Width="36" />
                            <SelectableTextBlock Classes.listBoxItemText="True" Text="{Binding Text}" Foreground="{Binding Foreground}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Footer  -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3,3,0">
                <TextBlock Classes.footerText="True" VerticalAlignment="Center" Margin="0,0,0,0" Text="Lines: " />
                <TextBlock Classes.footerText="True" VerticalAlignment="Center" Text="{Binding SelectedOutputLines.Count, FallbackValue=0}" />
                <TextBlock Classes.footerText="True" VerticalAlignment="Center" Margin="2,0,2,0" Text="/" />
                <TextBlock Classes.footerText="True" VerticalAlignment="Center" Text="{Binding OutputLines.Count, FallbackValue=0}" />
            </StackPanel>

            <!--  Input panel  -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <TextBox Grid.Column="0"
                         Classes.rounded="True"
                         Text="{Binding InputText}"
                         PlaceholderText="Type input and press Enter..."
                         IsVisible="{Binding !IsPasswordMode}"
                         VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SubmitInputCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <TextBox Grid.Column="0"
                         Classes.rounded="True"
                         Text="{Binding InputText}"
                         PlaceholderText="Password prompt detected — input masked"
                         PasswordChar="●"
                         IsVisible="{Binding IsPasswordMode}"
                         VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SubmitInputCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Send" Command="{Binding SubmitInputCommand}"
                        Margin="6,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
