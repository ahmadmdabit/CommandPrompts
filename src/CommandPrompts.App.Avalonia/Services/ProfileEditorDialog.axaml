<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CommandPrompts.App.Avalonia.ViewModels"
        xmlns:converters="using:Avalonia.Data.Converters"
        x:Class="CommandPrompts.App.Avalonia.Services.ProfileEditorDialog"
        x:DataType="vm:ProfileEditorViewModel"
        Title="Manage Env Profiles"
        Icon="/Assets/CommandPrompts.App.ico"
        Background="{StaticResource BackgroundBrush}"
        Width="640" Height="420"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="180,*" ColumnSpacing="12">
            <!-- Profile list -->
            <Grid RowDefinitions="Auto,*" Grid.Column="0">
                <TextBlock Grid.Row="0" Text="Profiles" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,6" />
                <ListBox Grid.Row="1" Classes.rounded="true" 
                    ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    DisplayMemberBinding="{Binding Name}" />
            </Grid>

            <!-- Editor -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Name:" Margin="0,0,0,6"
                           Foreground="{StaticResource ForegroundBrush}" />
                <TextBox Grid.Row="1" Margin="0,0,0,6" Classes.rounded="True" Text="{Binding EditName}" />
                <TextBlock Grid.Row="2" Text="Variables (one per line: KEY=VALUE):" Margin="0,0,0,6" Foreground="{StaticResource ForegroundBrush}" />
                <TextBox Grid.Row="3" Classes.rounded="True" AcceptsReturn="True"
                    Text="{Binding EditVariablesText}" VerticalAlignment="Stretch"
                    ToolTip.Tip="One per line: KEY=VALUE" />
                <TextBlock Grid.Row="4" Margin="0,6,0,0" Text="{Binding ErrorMessage}"
                    Foreground="{StaticResource ErrorColor}"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="New" Command="{Binding NewCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
            <Button Classes.destructive="True" Content="Delete" Command="{Binding DeleteCommand}" />
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
