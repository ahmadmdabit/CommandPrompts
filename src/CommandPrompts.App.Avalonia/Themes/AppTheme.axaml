<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Dark console-like palette — 1:1 port of WPF src/CommandPrompts.App/Themes/Theme.xaml colors  -->

    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="SurfaceColor">#292929</Color>
    <Color x:Key="GroupColor">#222222</Color>
    <Color x:Key="ForegroundColor">#CCCCCC</Color>
    <Color x:Key="AccentColor">#60993E</Color>
    <Color x:Key="ErrorColor">#A02060</Color>
    <Color x:Key="SystemColor">#608B3E</Color>
    <Color x:Key="BorderColor">#3F3F46</Color>
    <Color x:Key="ConsoleBackgroundColor">#0C0C0C</Color>
    <Color x:Key="SecondaryBackgroundColor">#555555</Color>
    <Color x:Key="HoverBackgroundColor">#2A2A2A</Color>
    <Color x:Key="TimestampColor">#666666</Color>
    <Color x:Key="RunningIndicatorColor">#3CAF60</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="GroupBrush" Color="{StaticResource GroupColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SystemBrush" Color="{StaticResource SystemColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="{StaticResource ConsoleBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="TimestampBrush" Color="{StaticResource TimestampColor}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{StaticResource RunningIndicatorColor}" />

</ResourceDictionary>
